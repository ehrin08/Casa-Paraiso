APP_NAME="Casa Paraiso"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:18001
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_PORT=18001
FORWARD_VITE_PORT=15173
SUPER_ADMIN_EMAIL=admin@example.com

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=casa_paraiso
DB_USERNAME=sail
DB_PASSWORD=password
MYSQL_ROOT_PASSWORD=rootpassword
FORWARD_DB_PORT=13306
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=casa-paraiso-local
REVERB_APP_KEY=casa-paraiso-local-key
REVERB_APP_SECRET=casa-paraiso-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://localhost:18001

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
FORWARD_MAILPIT_PORT=11026
FORWARD_MAILPIT_DASHBOARD_PORT=18025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FORCE_HTTPS=false
HSTS_ENABLED=false
TRUSTED_HOSTS=
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
SYSTEM_ERROR_REPORTING_ENABLED=true
SYSTEM_ERROR_RETENTION_DAYS=30
SYSTEM_ERROR_BADGE_CACHE_SECONDS=30
SENTIMENT_CLASSIFIER_MODE=rules
SENTIMENT_MODEL_THRESHOLD=0.80
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
VITE_APP_NAME="${APP_NAME}"

# Copy to the PRIVATE application directory as .env and fill values privately.
# For the existing-data transfer, retain the current APP_KEY; never replace it.
APP_NAME="Casa Paraiso"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://replace-your-domain.invalid
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
SUPER_ADMIN_EMAIL=

DB_CONNECTION=mysql
# Use the exact hPanel hostname, prefixed database name and user.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Use the authenticated mailbox/provider settings; confirm scheme and port.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

FORCE_HTTPS=true
# Enable only after the domain AND its subdomains have working HTTPS.
HSTS_ENABLED=false
# Exact anchored regexes separated by commas, e.g. ^spa\.your-domain\.com$
TRUSTED_HOSTS=
# Leave empty for direct TLS. Set ONLY verified proxy IPs/CIDRs if needed.
TRUSTED_PROXIES=
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
SYSTEM_ERROR_REPORTING_ENABLED=true
SYSTEM_ERROR_RETENTION_DAYS=30
SYSTEM_ERROR_BADGE_CACHE_SECONDS=30
SENTIMENT_CLASSIFIER_MODE=rules
SENTIMENT_MODEL_THRESHOLD=0.80

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Also authorize ${APP_URL}/profile/password/google/callback in Google Console.
